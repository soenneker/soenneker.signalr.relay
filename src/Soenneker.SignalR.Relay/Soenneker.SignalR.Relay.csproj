<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>
    <PropertyGroup>
        <Description>Containerized relay for ASP.NET Core SignalR</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.SignalR.Relay</AssemblyName>
        <PackageId>Soenneker.SignalR.Relay</PackageId>
        <PackageTags>signalr websockets signalrrelay library csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>false</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.signalr.relay</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.signalr.relay</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">$(PACKAGE_RELEASE_NOTES)</PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Atomics.Longs" Version="11.0.39" />
        <PackageReference Include="Soenneker.Atomics.ValueBools" Version="11.0.57" />
        <PackageReference Include="Soenneker.Atomics.ValueInts" Version="11.0.43" />
        <PackageReference Include="Soenneker.Asyncs.Locks" Version="11.0.124" />
        <PackageReference Include="Soenneker.Utils.Random" Version="11.0.151" />
        <PackageReference Include="Soenneker.Utils.Json" Version="11.0.2797" />
        <PackageReference Include="MessagePack" Version="4.0.0-rc.1" />
        <PackageReference Include="Microsoft.Azure.SignalR.Protocols" Version="1.34.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Soenneker.SignalR.Relay.Tests" />
    </ItemGroup>
</Project>
